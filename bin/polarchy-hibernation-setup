#!/bin/bash

set -euo pipefail

# Find swap device (simple heuristics: /swap or first /dev entry in /proc/swaps)
swap_dev=""

if findmnt -n -o SOURCE /swap &>/dev/null; then
  swap_dev=$(findmnt -n -o SOURCE /swap)
else
  swap_dev=$(grep -m1 '^/dev' /proc/swaps | awk '{print $1}' || true)
fi

if [[ -z "${swap_dev:-}" ]]; then
  echo "No swap device found; cannot configure hibernation for GRUB" >&2
  exit 1
fi

resume_uuid=$(blkid -s UUID -o value "$swap_dev" 2>/dev/null || true)
if [[ -z "${resume_uuid:-}" ]]; then
  echo "Could not read UUID for $swap_dev" >&2
  exit 1
fi

echo "Configuring hibernation for GRUB using swap: $swap_dev (UUID=$resume_uuid)"

# 1) Ensure resume hook in mkinitcpio (basic, additive edit)
if grep -q '^HOOKS=' /etc/mkinitcpio.conf; then
  if ! grep -q 'resume' /etc/mkinitcpio.conf; then
    sudo sed -i 's/^HOOKS=(\(.*\))/HOOKS=(\1 resume)/' /etc/mkinitcpio.conf
  fi
else
  echo "Warning: HOOKS= not found in /etc/mkinitcpio.conf; not touching hooks"
fi

# 2) Add resume= to GRUB cmdline
if [[ -f /etc/default/grub ]]; then
  # Add/replace resume= in GRUB_CMDLINE_LINUX_DEFAULT
  if grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' /etc/default/grub; then
    # Strip any existing resume= entries
    sudo sed -i 's/resume=[^[:space:]]*//g' /etc/default/grub
    sudo sed -i "s/^GRUB_CMDLINE_LINUX_DEFAULT=\"/GRUB_CMDLINE_LINUX_DEFAULT=\"resume=UUID=$resume_uuid /" /etc/default/grub
  else
    echo "GRUB_CMDLINE_LINUX_DEFAULT=\"resume=UUID=$resume_uuid\"" | sudo tee -a /etc/default/grub >/dev/null
  fi
else
  echo "Warning: /etc/default/grub missing; skipping GRUB cmdline changes"
fi

# 3) Rebuild initramfs
echo "Rebuilding initramfs (mkinitcpio -P)..."
sudo mkinitcpio -P

# 4) Regenerate GRUB config
if [[ -d /boot/grub ]]; then
  echo "Regenerating /boot/grub/grub.cfg..."
  sudo grub-mkconfig -o /boot/grub/grub.cfg
else
  echo "Warning: /boot/grub not found; skipping grub-mkconfig"
fi

echo "Hibernation should now be enabled. Test with systemctl hibernate."
