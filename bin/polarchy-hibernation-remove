#!/bin/bash

set -euo pipefail

echo "Disabling hibernation for GRUB..."

# 1) Remove resume hook from mkinitcpio
if [[ -f /etc/mkinitcpio.conf ]]; then
  if grep -q 'resume' /etc/mkinitcpio.conf; then
    sudo sed -i 's/ resume//g; s/resume //g' /etc/mkinitcpio.conf
  fi
fi

# 2) Strip resume= from GRUB cmdline
if [[ -f /etc/default/grub ]]; then
  sudo sed -i 's/resume=[^[:space:]]*//g' /etc/default/grub
fi

# 3) Rebuild initramfs
echo "Rebuilding initramfs (mkinitcpio -P)..."
sudo mkinitcpio -P

# 4) Regenerate GRUB config
if [[ -d /boot/grub ]]; then
  echo "Regenerating /boot/grub/grub.cfg..."
  sudo grub-mkconfig -o /boot/grub/grub.cfg
else
  echo "Warning: /boot/grub not found; skipping grub-mkconfig"
fi

echo "Hibernation disabled (resume hooks/cmdline removed)."
